# Read by `npm run build` (and so by deploy/deploy.sh). `npm run dev` ignores this file.

# Leave empty: the site and the API are served from the same address,
# so the app calls /api and /images on whatever host it was loaded from.
VITE_BACK_END_URL=

# Your CloudFront address (no trailing slash). Stripe sends buyers back here after paying.
VITE_FRONTEND_URL=https://REPLACE_ME.cloudfront.net

# Stripe publishable key (pk_test_...). It's meant to be public, so committing it is fine.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
